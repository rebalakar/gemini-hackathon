# SHERD-FORGE Configuration
# Runs completely without an API key using deterministic OpenCV, SciPy, and SQLite algorithms.
# When provided, Gemini enhances fragment qualitative observations and typology explanations.

HOST=127.0.0.1
PORT=8000
DATABASE_PATH=backend/data/sherd_forge.db
UPLOAD_DIR=backend/data/uploads

# Optional AI configuration (Google Gemini)
# Leave empty to run strictly in offline/deterministic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
